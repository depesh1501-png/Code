<script>

/* DARK MODE */

function toggleTheme(){

    document.body.classList.toggle("dark");

    localStorage.setItem(
        "theme",
        document.body.classList.contains("dark")
        ? "dark"
        : "light"
    );
}

if(localStorage.getItem("theme")==="dark"){
    document.body.classList.add("dark");
}


/* MOBILE MENU */

function toggleMenu(){

    document
    .getElementById("navLinks")
    .classList.toggle("show");

}


/* CODE PLAYGROUND */

function runCode(){

    const code =
    document.getElementById("codeEditor").value;

    document
    .getElementById("preview")
    .srcdoc = code;

}


/* INITIAL PREVIEW */

window.onload=function(){
    runCode();
};


/* SEARCH */

function searchCourses(){

    const input =
    document
    .getElementById("courseSearch")
    .value
    .toLowerCase();

    const courses =
    document
    .querySelectorAll(".course");

    courses.forEach(course=>{

        const name =
        course
        .querySelector("h3")
        .textContent
        .toLowerCase();

        course.style.display =
        name.includes(input)
        ? "block"
        : "none";

    });

}


/* QUIZ */

function checkAnswer(correct){

    const result =
    document
    .getElementById("quizResult");

    if(correct){

        result.innerHTML =
        "🎉 Correct! The &lt;a&gt; tag creates hyperlinks.";

        result.style.color =
        "#00b894";

    }else{

        result.innerHTML =
        "❌ Not quite. Try again!";

        result.style.color =
        "#e74c3c";

    }

}


/* SCROLL REVEAL */

const observer =
new IntersectionObserver(
entries=>{

    entries.forEach(entry=>{

        if(entry.isIntersecting){

            entry.target
            .classList
            .add("active");

        }

    });

},
{
    threshold:.15
});


document
.querySelectorAll(".reveal")
.forEach(el=>{
    observer.observe(el);
});

</script>

