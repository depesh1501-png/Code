<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CodeLearn 2.0 | Learn. Build. Master.</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Inter,Segoe UI,Arial,sans-serif;
}

:root{
    --bg:#f6f8fc;
    --card:#ffffff;
    --text:#172033;
    --muted:#687386;
    --primary:#635bff;
    --secondary:#00b894;
    --border:#e5e8ef;
    --code:#111827;
    --nav:#ffffffd9;
    --shadow:0 15px 40px rgba(20,30,60,.08);
}

.dark{
    --bg:#0b1020;
    --card:#151b2e;
    --text:#f3f5ff;
    --muted:#a5aec4;
    --border:#283149;
    --nav:#10162ad9;
    --shadow:0 15px 40px rgba(0,0,0,.3);
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--bg);
    color:var(--text);
    transition:.3s;
}

/* NAVBAR */

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:var(--nav);
    backdrop-filter:blur(15px);
    border-bottom:1px solid var(--border);
}

.navbar{
    max-width:1200px;
    margin:auto;
    height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 20px;
}

.logo{
    font-size:24px;
    font-weight:800;
    color:var(--primary);
}

.logo span{
    color:var(--text);
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
}

.nav-links a{
    color:var(--text);
    text-decoration:none;
    font-weight:600;
    font-size:14px;
}

.nav-links a:hover{
    color:var(--primary);
}

.nav-actions{
    display:flex;
    align-items:center;
    gap:10px;
}

.icon-btn{
    border:1px solid var(--border);
    background:var(--card);
    color:var(--text);
    width:40px;
    height:40px;
    border-radius:50%;
    cursor:pointer;
}

.menu{
    display:none;
}

/* HERO */

.hero{
    max-width:1200px;
    margin:auto;
    padding:90px 20px 70px;
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:50px;
    align-items:center;
}

.badge{
    display:inline-block;
    padding:8px 14px;
    border-radius:30px;
    background:#e9e7ff;
    color:#5048df;
    font-size:13px;
    font-weight:700;
    margin-bottom:20px;
}

.hero h1{
    font-size:clamp(42px,6vw,72px);
    line-height:1;
    margin-bottom:25px;
    letter-spacing:-3px;
}

.gradient{
    background:linear-gradient(90deg,#635bff,#00b894);
    -webkit-background-clip:text;
    color:transparent;
}

.hero p{
    color:var(--muted);
    font-size:18px;
    line-height:1.7;
    max-width:650px;
}

.buttons{
    margin-top:30px;
    display:flex;
    gap:15px;
}

.btn{
    padding:14px 22px;
    border-radius:10px;
    text-decoration:none;
    font-weight:700;
    display:inline-block;
    cursor:pointer;
    border:none;
}

.primary{
    background:var(--primary);
    color:white;
}

.outline{
    border:1px solid var(--border);
    color:var(--text);
    background:var(--card);
}

.btn:hover{
    transform:translateY(-2px);
}

/* CODE CARD */

.code-card{
    background:var(--code);
    border-radius:20px;
    box-shadow:var(--shadow);
    overflow:hidden;
    transform:rotate(2deg);
}

.code-top{
    padding:13px 18px;
    background:#1c2435;
    display:flex;
    gap:7px;
}

.dot{
    width:11px;
    height:11px;
    border-radius:50%;
    background:#6b7280;
}

.code{
    padding:25px;
    color:#d1d5db;
    line-height:1.8;
    font-family:monospace;
    font-size:14px;
}

.keyword{color:#c084fc}
.tag{color:#60a5fa}
.string{color:#86efac}
.comment{color:#6b7280}

/* STATS */

.stats{
    max-width:1150px;
    margin:0 auto 70px;
    padding:0 20px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.stat{
    background:var(--card);
    border:1px solid var(--border);
    padding:25px;
    border-radius:16px;
}

.stat h2{
    font-size:30px;
}

.stat p{
    color:var(--muted);
    margin-top:5px;
}

/* SECTION */

.section{
    max-width:1200px;
    margin:auto;
    padding:70px 20px;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title h2{
    font-size:38px;
    margin-bottom:10px;
}

.section-title p{
    color:var(--muted);
}

/* SEARCH */

.search-box{
    max-width:600px;
    margin:0 auto 35px;
}

.search-box input{
    width:100%;
    padding:16px 20px;
    border:1px solid var(--border);
    border-radius:12px;
    outline:none;
    background:var(--card);
    color:var(--text);
    font-size:15px;
}

/* COURSES */

.courses{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.course{
    background:var(--card);
    border:1px solid var(--border);
    padding:25px;
    border-radius:18px;
    transition:.3s;
}

.course:hover{
    transform:translateY(-7px);
    box-shadow:var(--shadow);
}

.course-icon{
    font-size:35px;
    margin-bottom:18px;
}

.course h3{
    margin-bottom:8px;
}

.course p{
    color:var(--muted);
    font-size:14px;
    line-height:1.6;
}

.level{
    display:inline-block;
    margin-top:18px;
    font-size:12px;
    padding:5px 10px;
    border-radius:20px;
    background:#e9e7ff;
    color:#5148dc;
}

.progress{
    height:6px;
    background:var(--border);
    border-radius:20px;
    margin-top:18px;
    overflow:hidden;
}

.progress span{
    display:block;
    height:100%;
    background:var(--primary);
}

/* ROADMAP */

.roadmap{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.step{
    background:var(--card);
    border:1px solid var(--border);
    padding:30px;
    border-radius:18px;
    position:relative;
}

.number{
    width:45px;
    height:45px;
    border-radius:50%;
    background:var(--primary);
    color:white;
    display:grid;
    place-items:center;
    font-weight:bold;
    margin-bottom:20px;
}

/* PLAYGROUND */

.playground{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.editor,
.output{
    background:var(--code);
    border-radius:16px;
    overflow:hidden;
}

.editor textarea{
    width:100%;
    height:330px;
    resize:none;
    border:none;
    outline:none;
    padding:20px;
    background:#111827;
    color:#e5e7eb;
    font-family:monospace;
    font-size:14px;
}

.output iframe{
    width:100%;
    height:330px;
    background:white;
    border:0;
}

.run{
    width:100%;
    padding:14px;
    background:var(--secondary);
    border:0;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

/* QUIZ */

.quiz{
    max-width:700px;
    margin:auto;
    background:var(--card);
    border:1px solid var(--border);
    padding:30px;
    border-radius:20px;
}

.option{
    width:100%;
    text-align:left;
    padding:14px;
    margin-top:10px;
    border:1px solid var(--border);
    background:var(--bg);
    color:var(--text);
    border-radius:10px;
    cursor:pointer;
}

.option:hover{
    border-color:var(--primary);
}

#quizResult{
    margin-top:20px;
    font-weight:bold;
}

/* CTA */

.cta{
    max-width:1100px;
    margin:50px auto;
    padding:65px 25px;
    text-align:center;
    border-radius:25px;
    background:linear-gradient(120deg,#635bff,#00b894);
    color:white;
}

.cta h2{
    font-size:40px;
    margin-bottom:15px;
}

.cta p{
    margin-bottom:25px;
}

/* FOOTER */

footer{
    border-top:1px solid var(--border);
    padding:40px 20px;
    text-align:center;
    color:var(--muted);
}

.footer-logo{
    font-size:25px;
    font-weight:800;
    color:var(--primary);
    margin-bottom:10px;
}

/* ANIMATION */

.reveal{
    opacity:0;
    transform:translateY(25px);
    transition:opacity .7s,transform .7s;
}

.reveal.active{
    opacity:1;
    transform:translateY(0);
}

/* MOBILE */

@media(max-width:900px){

    .hero{
        grid-template-columns:1fr;
        text-align:center;
    }

    .hero p{
        margin:auto;
    }

    .buttons{
        justify-content:center;
    }

    .code-card{
        transform:none;
    }

    .courses{
        grid-template-columns:repeat(2,1fr);
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .roadmap{
        grid-template-columns:1fr;
    }

    .playground{
        grid-template-columns:1fr;
    }

    .nav-links{
        display:none;
        position:absolute;
        top:72px;
        left:0;
        width:100%;
        padding:25px;
        background:var(--card);
        flex-direction:column;
        border-bottom:1px solid var(--border);
    }

    .nav-links.show{
        display:flex;
    }

    .menu{
        display:block;
    }
}

@media(max-width:550px){

    .courses,
    .stats{
        grid-template-columns:1fr;
    }

    .hero{
        padding-top:60px;
    }

    .hero h1{
        letter-spacing:-2px;
    }
}
</style>
</head>

<body>

