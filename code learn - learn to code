            </div>

        </div>


        <div class="code-example">

            <h3>SQL Example:</h3>

            <pre><code>SELECT *
FROM Customers
WHERE Country = 'India';</code></pre>

            <button class="try-btn">Try it Yourself »</button>

        </div>

    </div>

